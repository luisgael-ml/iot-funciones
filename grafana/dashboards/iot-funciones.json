      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "iot-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT x.sensor, e.lecturas, e.promedio, e.minimo, e.maximo, e.desviacion, e.sobre_umbral AS \"sobre umbral\", e.situacion\nFROM unnest(ARRAY['PRE03-TEMP','PRE03-VIB','PRE03-ENE','TOR01-TEMP','TOR01-VIB','TOR01-ENE','EMB02-TEMP','EMB02-VIB','EMB02-ENE']) AS x(sensor)\nCROSS JOIN LATERAL fn_estadisticas_sensor(x.sensor, NOW() - INTERVAL '1 hour') AS e"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "situacion"
            },
            "properties": [
