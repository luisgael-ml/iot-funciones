    {
      "id": 9,
      "type": "table",
      "title": "Estadisticas de la ultima hora por sensor (fn_estadisticas_sensor)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "iot-pg"
      },
      "gridPos": {
