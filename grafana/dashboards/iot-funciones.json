    {
      "id": 8,
      "type": "table",
      "title": "Prediccion a 30 minutos por regresion lineal (fn_prediccion)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "iot-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "iot-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sensor, actual, proyectado, umbral, pendiente_hora AS \"pendiente/h\", confianza AS \"confianza (R²)\",\n       minutos_al_umbral AS \"min al umbral\", riesgo\nFROM fn_prediccion(3, 30)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "riesgo"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "normal": {
                        "color": "green",
                        "index": 0
                      },
                      "estable": {
                        "color": "green",
                        "index": 1
                      },
                      "advertencia": {
                        "color": "orange",
                        "index": 2
                      },
                      "subiendo": {
                        "color": "orange",
                        "index": 3
                      },
                      "critica": {
                        "color": "red",
                        "index": 4
                      },
                      "riesgo de pico": {
                        "color": "red",
                        "index": 5
                      },
                      "sin tendencia": {
                        "color": "gray",
                        "index": 6
                      },
                      "sin datos": {
                        "color": "gray",
                        "index": 7
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      }
