          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT tiempo AS time, sensor AS metric, promedio AS value\nFROM fn_serie_promedios('temperatura', $__timeFrom()::timestamptz, $__timeTo()::timestamptz, '1 minute')"
